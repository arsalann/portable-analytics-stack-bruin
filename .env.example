# Cloudflare R2 / S3-compatible credentials
AWS_ACCESS_KEY_ID=fill_this_in
AWS_SECRET_ACCESS_KEY=fill_this_in
AWS_REGION=auto
DUCKLAKE_DATA_PATH=s3://your-r2-bucket/portable-analytics-stack/ducklake
R2_S3_ENDPOINT=your-account-id.r2.cloudflarestorage.com

# Neon Postgres DuckLake catalog credentials
POSTGRES_HOST=fill_this_in
POSTGRES_DB=fill_this_in
POSTGRES_USER=fill_this_in
POSTGRES_PASSWORD=fill_this_in
POSTGRES_PORT=5432

# Socrata app token required by Bruin's Socrata ingestr connector.
SOCRATA_APP_TOKEN=fill_this_in
